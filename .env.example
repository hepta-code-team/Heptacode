# Runtime environment for the backend.
NODE_ENV=development

# Port used by the backend server.
PORT=3000

# Frontend origin allowed to access the backend during local development.
CORS_ORIGIN=http://localhost:5173

# Base URL of the AI service endpoint.
AI_API_URL=http://ki-server.example.com/v1

# API key used to authenticate with the AI service.
AI_API_KEY=dummy

# Primary AI model used for application requests.
AI_MODEL=medgemma:27b

# Backup AI model used when the primary model is unavailable.
FALLBACK_MODEL=medgemma:4b

# Google Maps API key used for map and location features.
GOOGLE_MAPS_API_KEY=dummy

# Facility data source selection. Use "auto" unless a specific provider is required.
VITE_FACILITY_DATA_PROVIDER=auto

# FHIR endpoint for real outgoing Bundle POSTs, for example:
# FHIR_ENDPOINT=https://hapi.fhir.org/baseR4/Bundle
FHIR_ENDPOINT=

# Optional bearer token for a real FHIR endpoint.
FHIR_AUTH_TOKEN=

# Timeout for real FHIR HTTP requests in milliseconds.
FHIR_REQUEST_TIMEOUT_MS=10000
